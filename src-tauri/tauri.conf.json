{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Alexandria",
    "version": "0.0.1",
    "identifier": "com.alexandria.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5184",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Alexandria",
                "width": 570,
                "height": 850,
                "minWidth": 360,
                "minHeight": 560,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "visible": true,
                "backgroundColor": "#0f0f11"
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "endpoints": ["https://gnosis-xi.com/alexandria/latest.json"],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCNEY4OEU0ODM1MzdBN0UKUldSK2VsT0Q1SWhQeTVrMlFjaW8yNzdlaTRMSlJsczVlTFRQck5nOFRURGs1VWlyZXlDM2F4clUK",
            "dialog": false
        }
    }
}
